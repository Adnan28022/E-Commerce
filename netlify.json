{
    "build": {
        "command": "cd frontend && npm install && npm run build",
        "publish": "frontend/dist",
        "functions": "netlify/functions"
    },
    "redirects": [
        {
            "from": "/api/*",
            "to": "/.netlify/functions/server",
            "status": 200
        },
        {
            "from": "/uploads/*",
            "to": "/uploads/:splat",
            "status": 200
        },
        {
            "from": "/*",
            "to": "/index.html",
            "status": 200
        }
    ]
}