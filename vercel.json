{
    "version": 2,
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "server.js"
        },
        {
            "src": "/uploads/(.*)",
            "dest": "uploads/$1"
        },
        {
            "src": "/(.*)",
            "dest": "dist/index.html"
        }
    ]
}